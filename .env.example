# Copy to `.env` for local development. Never commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ reach the browser — no secret may use that prefix.

# --- Application ---------------------------------------------------------
# Public origin of the site. Used for auth cookies, CSRF/origin checks and links in emails.
APP_URL=http://localhost:3000

# Header the reverse proxy OVERWRITES with the real client IP (used for rate limiting).
# Required in production, e.g. "cf-connecting-ip" (Cloudflare) or "x-real-ip" (nginx).
# Never use a header clients can set themselves. Leave empty in local development.
TRUSTED_IP_HEADER=
# Optional: comma-separated proxy IPs/CIDRs if you rely on a multi-hop X-Forwarded-For chain.
TRUSTED_PROXIES=

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://academy:academy_dev_password@localhost:5433/academy

# --- Auth (Better Auth) --------------------------------------------------
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# --- Private object storage (S3-compatible) -------------------------------
# Local: SeaweedFS from docker-compose. Production: Cloudflare R2 / any S3-compatible provider.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=academy-private
S3_ACCESS_KEY_ID=academy_dev_access_key
S3_SECRET_ACCESS_KEY=academy_dev_secret_key
# true for SeaweedFS/MinIO-style local endpoints; usually false for R2/AWS.
S3_FORCE_PATH_STYLE=true

# --- Email ---------------------------------------------------------------
# Local: Mailpit from docker-compose (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Beauty Academy <no-reply@localhost>"

# --- Realtime (Socket.IO service: `npm run realtime`) ----------------------
REALTIME_PORT=3100
# Public URL the browser connects to (not a secret). Leave empty when the service is served
# from the same origin under /realtime behind a reverse proxy.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3100

# --- Zoom ----------------------------------------------------------------
# demo = labelled demo classroom, no Zoom connection. live = real Zoom.
# Production must set this explicitly. With ZOOM_MODE=live, ALL variables below are required
# (the server refuses to start half-configured). See NOTES.md → "Zoom setup".
ZOOM_MODE=demo

# Meeting SDK app (Zoom Marketplace → General app → Embed → Meeting SDK). Signs SDK join tokens.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Server-to-Server OAuth app in the SAME academy Zoom account. Creates meetings, issues host ZAK.
ZOOM_S2S_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
# Email or user id of the licensed Zoom user who hosts the lessons.
ZOOM_HOST_USER_ID=

# Event subscription secret token (webhooks: meeting.started / meeting.ended).
# Endpoint URL to register in Zoom: <APP_URL>/api/webhooks/zoom
ZOOM_WEBHOOK_SECRET_TOKEN=

# none | cloud — "cloud" needs a Zoom plan with cloud recording.
ZOOM_AUTO_RECORDING=none

# 32 random bytes (base64url) used to encrypt stored meeting passcodes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=
