generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Auth — tables owned by Better Auth (generated by `npx auth generate`).
// Only change these in step with the Better Auth config in src/server/auth.
// =============================================================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// "admin" | "student". Set only by the server (admin plugin); never from a client request.
  role          String    @default("student")
  /// Better Auth admin plugin. We use `banned` as "account deactivated".
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  enrollments        LessonEnrollment[]     @relation("EnrollmentStudent")
  enrollmentsGranted LessonEnrollment[]     @relation("EnrollmentGrantor")
  lessonsCreated     Lesson[]
  invitationsCreated LessonInvitation[]
  redemptions        InvitationRedemption[]
  materialsUploaded  LessonMaterial[]
  notifications      Notification[]
  auditEntries       AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// =============================================================================
// Academy domain
// All timestamps are stored in UTC (timestamptz). "Expired" is never stored:
// it is derived from deadlines and server time in src/server/access.
// =============================================================================

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

/// Live meeting state. LIVE must come from a verified provider event (or the
/// explicit demo simulation) — never from the scheduled time alone.
enum MeetingStatus {
  NOT_PROVISIONED
  SCHEDULED
  LIVE
  ENDED
  ERROR
}

enum EnrollmentSource {
  ADMIN
  INVITATION
}

/// Lifecycle of an uploaded object (material or recording file).
enum ObjectStatus {
  PENDING
  READY
  FAILED
}

enum RecordingSource {
  UPLOAD
  ZOOM
}

enum RecordingStatus {
  WAITING
  PROCESSING
  IMPORTING
  READY
  FAILED
}

enum NotificationType {
  LESSON_STARTING_SOON
  LESSON_LIVE
  RECORDING_READY
}

/// Optional grouping of lessons; also powers the public Courses page.
model Course {
  id           String   @id @default(uuid(7)) @db.Uuid
  title        String
  slug         String   @unique
  summary      String?
  description  String?
  /// Free text so the owner can write e.g. "3 muaj" or "nga 150 €".
  durationText String?
  priceText    String?
  isPublic     Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  lessons Lesson[]

  @@index([isPublic, position])
}

model Lesson {
  id       String  @id @default(uuid(7)) @db.Uuid
  title    String
  /// Visible to anyone who can see the lesson card.
  summary  String?
  /// Detailed lesson information — only for students with current access.
  details  String?
  courseId String? @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  scheduledStartAt DateTime @db.Timestamptz(3)
  scheduledEndAt   DateTime @db.Timestamptz(3)
  /// Earliest moment students may request join credentials.
  joinOpensAt      DateTime @db.Timestamptz(3)
  /// Last moment of access to live, replay and materials (exclusive: now >= this is expired).
  accessExpiresAt  DateTime @db.Timestamptz(3)

  publication   PublicationStatus @default(DRAFT)
  meetingStatus MeetingStatus     @default(NOT_PROVISIONED)
  liveStartedAt DateTime?         @db.Timestamptz(3)
  liveEndedAt   DateTime?         @db.Timestamptz(3)
  /// True when the meeting is the clearly labelled demo classroom (ZOOM_MODE=demo).
  isDemo        Boolean           @default(false)

  /// Zoom meeting number (Zoom API `id`), stored as text (exceeds JS safe integers).
  /// Webhooks are matched on this: a scheduled meeting gets a NEW uuid every time it starts.
  zoomMeetingNumber         String?   @unique
  /// Meeting passcode, AES-256-GCM encrypted with APP_ENCRYPTION_KEY. Never sent to clients
  /// except inside a join/host authorization for a user the access policy allows.
  zoomPasscodeEncrypted     String?
  /// Zoom's `join_url` (carries Zoom's own encrypted `pwd`), AES-256-GCM encrypted like the
  /// passcode. Only for the "open in the Zoom app" fallback, after the same policy check as an
  /// embedded join. Filled at creation, or fetched from Zoom on first request.
  zoomJoinUrlEncrypted      String?
  /// Set while a meeting is being created in Zoom — a lock against duplicate meetings
  /// (double clicks, retries after a timeout). Cleared when creation finishes or fails.
  zoomProvisioningStartedAt DateTime? @db.Timestamptz(3)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  enrollments   LessonEnrollment[]
  invitations   LessonInvitation[]
  materials     LessonMaterial[]
  recordings    Recording[]
  notifications Notification[]

  @@index([publication, scheduledStartAt])
  @@index([meetingStatus])
  @@index([courseId])
}

model LessonEnrollment {
  id       String @id @default(uuid(7)) @db.Uuid
  lessonId String @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("EnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade)

  source          EnrollmentSource
  grantedById     String?
  grantedBy       User?            @relation("EnrollmentGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  /// Optional per-student deadline. Effective deadline = earliest of this and Lesson.accessExpiresAt.
  accessExpiresAt DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  redemptions InvitationRedemption[]

  @@unique([lessonId, userId])
  @@index([userId])
}

model LessonInvitation {
  id       String @id @default(uuid(7)) @db.Uuid
  lessonId String @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// SHA-256 of the random secret. The plaintext token is shown once and never stored.
  tokenHash       String    @unique
  /// Last moment the invitation can create an enrolment.
  redeemUntil     DateTime  @db.Timestamptz(3)
  /// Optional content deadline applied to enrolments created through this invitation.
  accessExpiresAt DateTime? @db.Timestamptz(3)
  /// When set, only this (lower-cased) email may redeem.
  email           String?
  /// Null = unlimited.
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  revokedAt       DateTime? @db.Timestamptz(3)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  redemptions InvitationRedemption[]

  @@index([lessonId])
}

model InvitationRedemption {
  id           String           @id @default(uuid(7)) @db.Uuid
  invitationId String           @db.Uuid
  invitation   LessonInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId String           @db.Uuid
  enrollment   LessonEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  /// Redemption is idempotent per student.
  @@unique([invitationId, userId])
  @@index([userId])
}

model LessonMaterial {
  id          String       @id @default(uuid(7)) @db.Uuid
  lessonId    String       @db.Uuid
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Server-generated, non-guessable key in private storage. Never a public URL.
  objectKey   String       @unique
  /// Sanitized display name.
  displayName String
  /// Verified after upload, not taken from the browser.
  mimeType    String
  sizeBytes   BigInt
  position    Int          @default(0)
  status      ObjectStatus @default(PENDING)
  /// Open multipart upload (video materials) while PENDING; cleared once completed.
  uploadId    String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([lessonId, status, position])
}

model Recording {
  id       String          @id @default(uuid(7)) @db.Uuid
  lessonId String          @db.Uuid
  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  source   RecordingSource
  status   RecordingStatus @default(WAITING)

  objectKey       String? @unique
  mimeType        String?
  sizeBytes       BigInt?
  durationSeconds Int?
  /// Provider layout name for imported recordings (e.g. shared_screen_with_speaker_view).
  layout          String?
  /// Interrupted meetings can produce several files; they are kept as separate parts.
  part            Int     @default(1)
  /// Zoom recording file id — idempotency key for imports.
  providerFileId  String? @unique
  /// Safe, non-secret description of the last failure.
  errorMessage    String?
  /// Multipart upload in progress (manual uploads); cleared when completed or aborted.
  uploadId        String?
  /// Display name for downloads ("Mësimi 3 — regjistrimi.mp4").
  displayName     String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  readyAt   DateTime? @db.Timestamptz(3)

  @@index([lessonId, status])
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String?          @db.Uuid
  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// e.g. "LESSON_LIVE:<lessonId>:<liveStartedAt>" — repeated events/polls never duplicate.
  dedupeKey String

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Marked read in the notification list.
  readAt      DateTime? @db.Timestamptz(3)
  /// Pop-up acknowledged ("Më vonë"/close). Does not mark the notification read.
  dismissedAt DateTime? @db.Timestamptz(3)
  /// After this the alert is stale and hidden from the pop-up.
  validUntil  DateTime? @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Every verified provider webhook, stored before it is acted on. `dedupeKey` makes repeated
/// deliveries harmless; FAILED rows can be retried by the admin "sync" action.
model WebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  provider      String
  /// e.g. "zoom:meeting.started:<meeting number>:<event_ts>"
  dedupeKey     String             @unique
  eventType     String
  meetingNumber String?
  /// Provider event time (ms since epoch) — used to ignore stale, out-of-order events.
  eventTs       BigInt
  status        WebhookEventStatus @default(RECEIVED)
  /// Safe, non-secret description of why it was ignored or failed.
  note          String?
  receivedAt    DateTime           @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?          @db.Timestamptz(3)

  @@index([provider, meetingNumber, eventTs])
  @@index([status, receivedAt])
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// e.g. "enrollment.revoke", "lesson.publish", "zoom.provision_failed"
  action     String
  targetType String
  targetId   String?
  /// Limited, non-secret context only.
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId])
}

// =============================================================================
// Public website content (edited through simple admin forms)
// =============================================================================

/// Singleton row (id = 1).
model AcademySettings {
  id           Int      @id @default(1)
  name         String   @default("Beauty Academy")
  tagline      String?
  about        String?
  address      String?
  phone        String?
  email        String?
  whatsapp     String?
  mapUrl       String?
  instagramUrl String?
  facebookUrl  String?
  /// [{ "days": "E Hënë – E Premte", "hours": "09:00 – 19:00" }, ...]
  openingHours Json?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Service {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  priceText   String?
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, position])
}

model GalleryItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Key in the public-assets area of storage (separate from private lesson files).
  imageKey    String   @unique
  alt         String
  caption     String?
  width       Int?
  height      Int?
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  showInGallery    Boolean  @default(false)
  showOnHomeHero   Boolean  @default(false)
  showOnHomeGallery Boolean @default(false)
  showOnAbout      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, position])
  @@index([isPublished, showInGallery, position])
  @@index([isPublished, showOnHomeHero, position])
  @@index([isPublished, showOnHomeGallery, position])
  @@index([isPublished, showOnAbout, position])
}
